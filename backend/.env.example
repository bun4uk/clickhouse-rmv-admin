# ClickHouse connection
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false        # true + port 8443 for ClickHouse Cloud (HTTPS)

# Scope / behaviour
DEFAULT_DATABASES=             # comma-separated allowlist; empty = all databases
POLL_INTERVAL_SECONDS=15
QUERY_LOG_CLUSTER=             # cluster name for clusterAllReplicas() on Cloud (e.g. default)
DISPLAY_TIMEZONE=UTC
