# Supply-chain hardening:
# ignore-scripts: never run packages' install/post-install scripts (a common
#   npm attack vector). Modern toolchain (Vite/esbuild/Tailwind oxide) ships
#   native binaries via optionalDependencies, so the build still works.
ignore-scripts=true
fund=false
audit=true
# Fail the install if the lockfile and package.json disagree (use `npm ci`).
engine-strict=false
